---
source: src/server.rs
expression: "policies[0].split(\"; \").collect::<Vec<_>>().join(\"\\n\")"
---
default-src 'none'
script-src 'nonce-[nonce]' 'strict-dynamic'
style-src 'self' 'unsafe-inline' https:
font-src https: data:
img-src 'self' http: https: data: blob:
media-src 'self' http: https:
connect-src 'self' ws://127.0.0.1:1
base-uri 'none'
form-action 'none'
frame-src https:
object-src 'none'
frame-ancestors 'none'
